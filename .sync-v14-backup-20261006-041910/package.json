{
  "name": "shadow-intelligence",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Live Solana/Pump.fun intelligence with transaction-level swap normalization, social evidence correlation, community, and multi-wallet copy-trading shell.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "NODE_ENV=development node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "delegated:artifact:check": "node scripts/verify-delegated-artifact.mjs",
    "delegated:artifact:stage": "bash scripts/stage-delegated-artifact.sh",
    "delegated:build:doctor": "bash scripts/build-shadow-delegated-replit.sh doctor",
    "delegated:build:replit": "bash scripts/build-shadow-delegated-replit.sh build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "web-push": "^3.6.7"
  }
}

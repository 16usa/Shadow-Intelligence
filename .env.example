PORT=3000
NODE_ENV=production

# Optional owner seed. If omitted, the first registered account becomes OWNER.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-password
OWNER_NAME=Owner

# LIVE SOLANA DATA
# Works without a key using Solana public mainnet RPC, but production use should set
# either SOLANA_RPC_URL or HELIUS_API_KEY for better reliability/history throughput.
SOLANA_RPC_URL=
HELIUS_API_KEY=

# X monitoring (optional). Create an X developer app and paste its app-only Bearer Token.
# Without this, manual Evidence still works and wallet monitoring remains live.
X_BEARER_TOKEN=

# Optional external copy-trading engine from the existing project.
COPY_ENGINE_URL=
COPY_ENGINE_TOKEN=

# Optional wallet -> profile/avatar resolver.
PUMP_PROFILE_LOOKUP_URL=
PUMP_PROFILE_TOKEN=

# Optional external intelligence provider health/integration hook.
INTELLIGENCE_PROVIDER_URL=
INTELLIGENCE_PROVIDER_TOKEN=

run = "npm start"
entrypoint = "server.mjs"
modules = ["nodejs-24"]

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[deployment]
run = ["sh", "-c", "npm start"]
deploymentTarget = "cloudrun"

[userenv]

[userenv.shared]
SHADOW_EXECUTION_MASTER_KEY = "fe82ced33567d72d5dff1b134058971f546aa27c321cae6573d41afe9bd634d7"
